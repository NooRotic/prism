{
  "manifest_version": 3,
  "name": "PRISM helper",
  "version": "0.2.0",
  "description": "Open YouTube videos and Twitch channels in PRISM, and send your Twitch recommendations and YouTube Watch Later into it.",
  "homepage_url": "https://prism.nooroticx.tv",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Open this page in PRISM",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "permissions": ["contextMenus", "activeTab"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*", "https://www.youtube.com/playlist*"],
      "js": ["handoff.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}

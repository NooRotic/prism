# The pages name the hashed files, so they are always asked for again; the hashed files never change. cast-device.js keeps its
# name from build to build, so it is asked for again too (this block comes last, so it wins over the one before for it).
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|cast-device\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

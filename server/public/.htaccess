# Apache on the IONOS host: no directory listings, no dotfiles, and every other URL goes to the front controller.
Options -Indexes

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# The target is the absolute URL path on purpose: the relative form 'index.php' gave the IONOS Apache a 500 on every routed URL.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ /index.php [L]

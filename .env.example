# Client ID from https://dev.twitch.tv/console/apps
VITE_TWITCH_CLIENT_ID=

# OAuth redirect URI — MUST byte-match what's registered in your Twitch app.
# Leave blank to auto-compute from `window.location.origin + BASE_URL`
# (works on production/GitHub Pages). For local dev set it explicitly because
# Vite's base path adds a trailing slash and Twitch matches exact strings.
#
# Dev value (matches `base: '/'` and `port: 5000` in vite.config.ts) —
# the trailing slash is required:
#   VITE_TWITCH_REDIRECT_URI=http://localhost:5000/
#
# Register that exact string in the Twitch console too. If the path here does
# not resolve to a real route, the OAuth return renders a blank page rather
# than an error: Vite's SPA fallback serves index.html for any path, so the
# request succeeds and React Router then matches nothing.
VITE_TWITCH_REDIRECT_URI=

# YouTube Data API v3 key from https://console.cloud.google.com/apis/credentials
# Used for browsing popular/category videos on the /youtube protocol page
VITE_YOUTUBE_API_KEY=
